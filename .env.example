# Ce fichier n'est qu'un exemple des variables de docker-compose.yml.
# En pratique, ne pas le remplir à la main : `node deploy/new-restaurant.mjs ...` génère
# deploy/restaurants/<slug>/.env avec des secrets aléatoires et des ports libres (voir README.md).
PROJECT=onyx-demo
RESTAURANT=fastcamion
DB_PASSWORD=
JWT_SECRET=
# Adresses publiques (derrière le proxy HTTPS du serveur)
SITE_URL=https://demo.byonyx.fr
API_URL=https://api.demo.byonyx.fr
IGNORE_HOURS=false
# Envoi des e-mails au client (voir onyx-order-api/.env.example)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONT_PORT=3000
API_PORT=4000
# Limites de ressources de ce restaurant
DB_CPUS=1.0
DB_MEM=512m
API_CPUS=0.5
API_MEM=384m
FRONT_CPUS=0.5
FRONT_MEM=512m
