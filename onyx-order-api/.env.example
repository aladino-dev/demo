# Copier en .env

# Base de données. Vide = PostgreSQL intégré lancé automatiquement (mode local, sans Docker)
# En production : postgres://utilisateur:motdepasse@hote:5432/onyx
DATABASE_URL=
LOCAL_DB_PORT=5433

API_PORT=4000
# Secret des sessions cuisine / back-office : longue chaîne aléatoire, obligatoire en production
JWT_SECRET=change-moi-en-local

# Adresses du front autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Dossier des photos produits (volume persistant en production)
PHOTOS_DIR=

# Envoi des e-mails au client (confirmation, commande prête, en livraison).
# Remplir avec le serveur SMTP de votre fournisseur (boîte de votre domaine, Brevo, Mailjet, Resend…).
# Vérifier avec : npm run email:test -- vous@exemple.fr   (SMTP_HOST vide = les e-mails restent en attente)
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465, false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché, ex. "FastCamion <commandes@votredomaine.fr>" (l'adresse doit appartenir à votre domaine)
SMTP_FROM=
# Adresse publique du site (lien « Suivre ma commande » dans les e-mails)
SITE_URL=http://localhost:3000

# Import de la carte par IA (photo ou PDF -> brouillon de produits à valider). Vide = fonction désactivée.
# La clé se crée sur la console Anthropic ; ne la partagez jamais (ni dans le chat, ni dans Git).
ANTHROPIC_API_KEY=
# Modèle utilisé (facultatif) : par défaut claude-opus-5-5 ; claude-sonnet-5-5 est moins cher et convient en général à la lecture d'une carte.
ANTHROPIC_MODEL=
# Limite d'imports par restaurant et par heure (maîtrise du coût)
IMPORT_MAX_PER_HOUR=10

# Démo : accepter les commandes même hors horaires d'ouverture
IGNORE_HOURS=true

# Livraison par coursiers Uber (Uber Direct). Pour les restaurants sans livreur : activer avec
# settings.delivery_provider = 'uber' sur le restaurant. Identifiants fournis par le tableau de bord Uber Direct
# (ne jamais les partager ni les mettre dans Git).
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
# Clé de signature des notifications Uber -> POST https://VOTRE-API/api/uber/webhook
UBER_WEBHOOK_SECRET=
# Test local sans compte Uber : simule les devis et les courses (UBER_MOCK_FEE_CENTS = prix fictif en centimes)
UBER_MOCK=
UBER_MOCK_FEE_CENTS=
