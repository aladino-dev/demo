# Copier en .env

# Adresse publique de l'API (onyx-order-api)
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
# Adresse de l'API vue depuis le serveur Next.js (dans un cluster : http://onyx-order-api:4000). Vide = NEXT_PUBLIC_API_URL
API_INTERNAL_URL=

# Restaurant servi par ce site
NEXT_PUBLIC_RESTAURANT=fastcamion
